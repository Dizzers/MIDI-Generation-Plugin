# =========================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Environments
venv/
.venv/
env/
ENV/

# =========================
# Logs / Temp
# =========================
*.log
*.tmp
*.bak
tmp/
temp/

# =========================
# Training artifacts
# =========================
checkpoints/*.pth
checkpoints/*.pt
checkpoints/*.ckpt
checkpoints/*.bin
checkpoints/skytnt/
checkpoints/lightning_ckpt/
checkpoints/lightning_logs/
checkpoints/history.json
checkpoints/generation_metrics.json
checkpoints/plots/

# =========================
# SkyTNT-export artefacts (large)
# =========================
artifacts/onnx/*.onnx
artifacts/onnx/*.onnx_data
artifacts/tokenizer/config.json
artifacts/examples/*.mid
!artifacts/.gitkeep
!artifacts/onnx/.gitkeep
!artifacts/tokenizer/.gitkeep
!artifacts/examples/.gitkeep

# Vendored upstream cache
skytnt_adapter/midi_model_upstream/__pycache__/
skytnt_adapter/midi_model_upstream/lightning_logs/
skytnt_adapter/midi_model_upstream/sample/

# Generated audio/MIDI
generated/
generated_*/
*.mid
*.midi

# Local cache
.cache/

# =========================
# Dataset artifacts (large files)
# =========================
dataset/processed/chunks/*.npy
dataset/processed/tokens/*.npy
dataset/processed/meta/*.json
dataset/processed/meta/*.txt
dataset/midi_raw/

# Keep vocab by default (small and useful for reproducibility)
!dataset/processed/vocab.json

*.zip
**/*.npy
**/dataset/processed/
